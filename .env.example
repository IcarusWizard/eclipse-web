# ==============================================================================
# Eclipse: Second Dawn - Asynchronous Turn Notification Configuration
# ==============================================================================
# Copy this file to .env and configure your SMTP credentials to enable automated
# BGA-style email turn reminders.
# If these variables are omitted, the server automatically enters "Mock Mode"
# and logs reminders to the terminal without attempting network delivery.
# ==============================================================================

# SMTP Relay Host (e.g., smtp-relay.brevo.com, smtp.gmail.com, etc.)
SMTP_HOST=smtp-relay.brevo.com

# SMTP Port (587 for STARTTLS / submission, 465 for direct SSL)
SMTP_PORT=587

# SMTP Secure Connection (set true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Username / Login (e.g. Brevo SMTP login or account email)
SMTP_USER=your_smtp_login_here

# SMTP Password or API Relay Key
SMTP_PASS=your_smtp_password_or_relay_key

# From / Sender field
# Important: Ensure the sender email is verified in your SMTP provider (e.g. Brevo sender dashboard).
SMTP_FROM="Eclipse High Command <notifications@yourdomain.com>"

# Public or local URL of your Eclipse deployment (used to build direct cockpit join links)
APP_URL=http://localhost:3000
